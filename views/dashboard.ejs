<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>
    <main class="dashboard">
      <%- include("partials/sidebar.ejs") %>
      <div id="dash-main">
        <% if (folders !== undefined) { %>
          <% folders.forEach(folder => { %>
              <div class="folder">
                <a href="/dashboard/folders/<%= folder.id %>">
                  <h2> <%=folder.name %> </h2>
                </a>
                <button onclick="document.getElementById('rename-folder-dialog-<%= folder.id%>').showModal()">Rename</button>
              </div>
              <dialog class="folder-dialog" id="rename-folder-dialog-<%=folder.id%>">
                <h3>Rename Folder</h3>
                <form action="/dashboard/folders/<%= folder.id%>/rename" method="POST">
                  <div class="dialog-form-field">
                    <label for="rename">Folder: </label>
                    <input type="text" id="renameFolder" name="renameFolder" value="<%= folder.name %>">
                  </div>
                  <button type="button" onclick="document.getElementById('rename-folder-dialog-<%=folder.id %>').close()">Cancel</button>
                  <button>Rename</button>
                </form>
              </dialog>
          <% }) %>
        <% } %>
      </div>
    </main>
    <%- include("partials/footer.ejs") %>
    <dialog id="create-folder-dialog">
      <h2>Create a New Folder</h2>
      <form action="/dashboard/create-folder" method="POST">
        <div class="dialog-form-field">
          <label for="newFolder">Folder Name: </label>
          <input type="text" id="newFolder" name="newFolder" />
        </div>
        <div class="action-btn-container">
          <button type="button"
            onclick="document.getElementById('create-folder-dialog').close()"
          >
            Cancel
          </button>
          <button
            onclick="document.getElementById('create-folder-dialog').close()"
          >
            Create
          </button>
        </div>
      </form>
    </dialog> 
  </body>
</html>
