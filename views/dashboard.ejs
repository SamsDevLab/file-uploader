<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>
    <main class="dashboard">
      <%- include("partials/sidebar.ejs", {folderId}) %>
      <div id="dash-main">
        <% if (folders !== undefined) { %>
          <% folders.forEach(folder => { %>
            <%- include("partials/folderContainer.ejs", {folder}) %>
          <% }) %>
        <% } %>
        <% if (files !== undefined) { %>
            <% files.forEach(file => { %>
              <%- include("partials/fileContainer.ejs", {file}) %>
            <% }) %>
         <% } %>
      </div>
    </main>
    <%- include("partials/footer.ejs") %>
    <dialog id="create-folder-dialog">
      <h2>Create a New Folder</h2>
      <form action="/dashboard/create-folder" method="POST">
        <div class="dialog-form-field">
          <label for="newFolder">Folder Name: </label>
          <input type="text" id="newFolder" name="newFolder" />
        </div>
        <div class="action-btn-container">
          <button type="button"
            onclick="document.getElementById('create-folder-dialog').close()"
          >
            Cancel
          </button>
          <button
            onclick="document.getElementById('create-folder-dialog').close()"
          >
            Create
          </button>
        </div>
      </form>
    </dialog> 
  </body>
</html>
