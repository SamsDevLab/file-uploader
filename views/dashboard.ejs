<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>
    <main class="dashboard">
      <%- include("partials/sidebar.ejs", {folderId, errorMessage}) %>
      <div class="dash-main">
        <% if (folders !== null) { %>
          <% folders.forEach(folder => { %>
            <%- include("partials/folderContainer.ejs", {folder}) %>
          <% }) %>
        <% } %>
        <% if (files !== null) { %>
            <% files.forEach(file => { %>
              <%- include("partials/fileContainer.ejs", {folderId, file}) %>
            <% }) %>
         <% } %>
      </div>
    </main>
  </body>
</html>
