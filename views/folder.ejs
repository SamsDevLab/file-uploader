<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs")%>
  <body>
    <%- include("partials/header.ejs") %>
    <main class="dashboard">
        <%- include("partials/sidebar.ejs", {folderId, errorMessage}) %>
      <div>
        <h2 class="folder-header"><%= folderContents.folderName %></h2>
        <div class="dash-main">
        <% if (folderContents !== undefined) { %>
           <% folderContents.files.forEach(file => { %>
              <%- include("partials/fileContainer.ejs", {folderId, file}) %>
           <% }) %>
        <% } %>
        </div>
      </div>
    </main>
  </body>
</html>
