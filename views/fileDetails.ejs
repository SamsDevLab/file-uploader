<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head.ejs") %>
  <body>
    <%- include("partials/header.ejs") %>
    <main class="file-details-container">
      <section class="file-details-main">
        <h2>File Details</h2>
        <div class="file-details-div">
          <p>Name:</p>
          <p><%=fileDetails.originalname %></p>
        </div>
        <div class="file-details-div">
          <p>Size:</p>
          <p><%= fileDetails.size %> bytes</p>
        </div>
        <div class="file-details-div">
          <p>Upload Time:</p>
          <p><%= fileDetails.createdAt %></p>
        </div>
        <div class="file-details-div">
          <p>Media Type:</p>
          <p><%= fileDetails.mimetype %></p>
        </div>
        <div class="file-details-action-container">
          <% if (folderId !== null) { %>
            <a class="file-details-button back-button" href="/dashboard/folders/<%= folderId %>">Back</a>
          <% } else { %>
            <a class="file-details-button back-button" href="/dashboard">Back</a>
          <% } %>
          <a class="file-details-button download-button" href="/dashboard/files/<%=fileDetails.id%>/download"
            >Download</a
          >
        </div>
      </section>
    </main>
    <%- include("partials/footer.ejs") %>
  </body>
</html>
