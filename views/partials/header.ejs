<header>
  <% if (currentUser === null) { %>
    <h1><a href="/">File Uploader App</a></h1>
  <% } else { %>
    <h1><a href="/dashboard">File Uploader App</a></h1>
  <% } %>
  <div class="auth-container">
    <% if (currentUser === null) { %>
    <a class="login-header-button" href="/auth/login">Log In</a>
    <a class="signup-header-button" href="/auth/signup">Sign Up</a> 
    <% } else { %>
      <a  class="signup-header-button" href="/auth/logout">Log Out</a>
    <% } %>
  </div>
</header>
