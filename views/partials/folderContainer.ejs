<div class="folder-and-file-container">
  <div class="title-and-menu-container">
    <a class="folder-name" href="/dashboard/folders/<%= folder.id %>">
      <% if (folder.truncatedName !== null){ %>
        <h2><%= folder.truncatedName %></h2>
      <% } else { %>
        <h2><%= folder.name %></h2>
      <% } %>
    </a>
    <div class="dropdown-folder-and-file">
      <svg
        width="16px"
        height="16px"
        viewBox="0 0 16 16"
        xmlns="http://www.w3.org/2000/svg"
        fill="#1C2541"
        class="bi bi-three-dots-vertical"
      >
        <path
          d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"
        />
      </svg>
      <div class="dropdown-content-folder-and-file">
        <button
          onclick="
            document
              .querySelector(`[data-rename-folder-dialog='<%=folder.id%>']`)
              .showModal()
          "
        >
          Rename
        </button>
        <form action="/dashboard/folders/<%= folder.id %>/delete" method="POST">
          <button class="delete-button">Delete</button>
        </form>
      </div>
    </div>
  </div>
  <svg
    width="60px"
    height="60px"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M3 8.2C3 7.07989 3 6.51984 3.21799 6.09202C3.40973 5.71569 3.71569 5.40973 4.09202 5.21799C4.51984 5 5.0799 5 6.2 5H9.67452C10.1637 5 10.4083 5 10.6385 5.05526C10.8425 5.10425 11.0376 5.18506 11.2166 5.29472C11.4184 5.4184 11.5914 5.59135 11.9373 5.93726L12.0627 6.06274C12.4086 6.40865 12.5816 6.5816 12.7834 6.70528C12.9624 6.81494 13.1575 6.89575 13.3615 6.94474C13.5917 7 13.8363 7 14.3255 7H17.8C18.9201 7 19.4802 7 19.908 7.21799C20.2843 7.40973 20.5903 7.71569 20.782 8.09202C21 8.51984 21 9.0799 21 10.2V15.8C21 16.9201 21 17.4802 20.782 17.908C20.5903 18.2843 20.2843 18.5903 19.908 18.782C19.4802 19 18.9201 19 17.8 19H6.2C5.07989 19 4.51984 19 4.09202 18.782C3.71569 18.5903 3.40973 18.2843 3.21799 17.908C3 17.4802 3 16.9201 3 15.8V8.2Z"
      stroke="#0b132b"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>

<dialog
  class="folder-and-file-dialog"
  data-rename-folder-dialog="<%= folder.id %>"
>
  <h3>Rename Folder</h3>
  <form
    class="create-and-rename-form"
    action="/dashboard/folders/<%= folder.id%>/rename"
    method="POST"
  >
    <div class="dialog-form-field">
      <label for="renameFolder">Folder: </label>
      <input
        type="text"
        id="renameFolder"
        name="renameFolder"
        value="<%= folder.name %>"
      />
    </div>
    <div class="action-button-container">
      <button class="action-cancel-button"
        type="button"
        onclick="
          document
            .querySelector(`[data-rename-folder-dialog='<%=folder.id %>']`)
            .close()
        "
      >
        Cancel
      </button>
      <button class="action-rename-button">Rename</button>
    </div>
  </form>
</dialog>
