<div class="sidebar">
  <div class="dropdown">
    <button id="new-button">+ New</button>
    <div class="dropdown-content">
      <% if (errorMessage !== null) { %>
        <p><%= errorMessage %></p>
      <% } %>
        <form
        <% if (folderId !== null) { %>
          action="/dashboard/upload-file/folder/<%= folderId %>"
        <% } else { %>
          action="/dashboard/upload-file"
        <% } %>
          enctype="multipart/form-data"
          method="POST"
        >
        <label class="dropdown-sidebar-button" for="file-upload">Upload File</label>
        <input
          type="file"
          name="uploadedFile"
          id="file-upload"
          onchange="this.form.requestSubmit()"
          hidden
        />
        
      </form>
      <% if (folderId === null) { %>
        <button class="dropdown-sidebar-button"
        onclick="document.getElementById('create-folder-dialog').showModal()"
      >
        New Folder
      </button>
      <% } %>
    </div>
  </div>
  <a href="/dashboard">Home</a>
  <h3>Made by Sam's Dev Lab</h3>
</div>
<dialog class="folder-and-file-dialog" id="create-folder-dialog">
  <h3>Create a New Folder</h3>
  <form class="create-and-rename-form" action="/dashboard/create-folder" method="POST">
    <div class="dialog-form-field">
      <label for="newFolder">Folder Name: </label>
      <input type="text" id="newFolder" name="newFolder" />
    </div>
    <div class="action-button-container">
      <button type="button"
        onclick="document.getElementById('create-folder-dialog').close()"
      >
        Cancel
      </button>
      <button
        onclick="document.getElementById('create-folder-dialog').close()"
      >
        Create
      </button>
    </div>
  </form>
</dialog> 